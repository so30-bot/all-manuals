---
import CookieConsent from '@/components/CookieConsent.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SeoHead from '@/components/SeoHead.astro';
import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown | unknown[];
};

const props = Astro.props;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="theme-color-meta" name="theme-color" content="#f8fafc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storageKey = 'all-manuals-theme';
        const readTheme = () => {
          try { const v = localStorage.getItem(storageKey); if (v === 'dark' || v === 'light') return v; } catch {}
          return 'light';
        };
        const applyTheme = (theme) => {
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
          root.dataset.resolvedTheme = theme;
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.content = theme === 'dark' ? '#020617' : '#f8fafc';
        };
        applyTheme(readTheme());
        window.__allManualsTheme = { applyTheme, readTheme, storageKey };
      })();
    </script>
    <SeoHead {...props} />
    <script is:inline src="/metrica.js"></script>
    <noscript><img src="https://mc.yandex.ru/watch/109481893" style="position:absolute;left:-9999px;width:1px;height:1px" alt=""></noscript>
  </head>
  <body>
    <div class="page-grid min-h-screen">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
      <CookieConsent />
    </div>
  </body>
</html>
