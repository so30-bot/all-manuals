---
import { getContactEmail } from '@/utils/seo';

const contactEmail = getContactEmail();
---

<footer class="mt-20 border-t border-slate-200 bg-white/70 dark:border-slate-800 dark:bg-slate-950/70">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:px-8 md:grid-cols-[1.5fr_1fr]">
    <div>
      <p class="text-sm font-semibold text-slate-950 dark:text-white">All Manuals</p>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-400">
        Информация представлена исключительно в ознакомительных целях. Администрация сайта не несет ответственности за возможный ущерб, возникший в результате использования представленных инструкций. Все действия вы выполняете на свой страх и риск. Перед внесением изменений всегда создавайте резервную копию системы.
      </p>
    </div>
    <div class="flex flex-col gap-2 text-sm text-slate-600 dark:text-slate-400">
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/about/">О сайте</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/errors/">Все ошибки</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/updates/">Обновления</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/feed.xml">RSS</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/dmca/">DMCA и авторские права</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/privacy/">Политика конфиденциальности</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href="/terms/">Условия использования</a>
      <a class="focus-ring rounded-lg hover:text-slate-950 dark:hover:text-white" href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </div>
  </div>
</footer>
