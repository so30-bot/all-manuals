---
type Props = {
  compact?: boolean;
};

const { compact = false } = Astro.props;
---

<div class={compact ? 'relative w-full' : 'relative mx-auto w-full max-w-3xl'} data-search-root>
  <label class="sr-only" for="site-search">Поиск ошибки</label>
  <input
    id="site-search"
    data-search-input
    class="focus-ring w-full rounded-2xl border border-slate-200 bg-white px-5 py-4 text-base text-slate-950 shadow-soft outline-none transition placeholder:text-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 sm:text-lg"
    type="search"
    autocomplete="off"
    placeholder="Введите код ошибки, симптом или программу..."
  />
  <div data-search-results class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-30 hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900"></div>
</div>

<script>
  type SearchItem = {
    title: string;
    slug: string;
    description: string;
    category: string;
    tags: string[];
    errorId?: string;
  };

  const roots = document.querySelectorAll<HTMLElement>('[data-search-root]');
  let indexPromise: Promise<SearchItem[]> | undefined;

  function getIndex() {
    indexPromise ??= fetch('/search-index.json').then((response) => response.ok ? response.json() : []);
    return indexPromise;
  }

  function scoreItem(item: SearchItem, query: string) {
    const haystack = [item.title, item.errorId, item.category, item.description, ...item.tags].filter(Boolean).join(' ').toLowerCase();
    const title = item.title.toLowerCase();
    if (title.includes(query)) return 5;
    if (item.errorId && query.includes(item.errorId.toLowerCase())) return 4;
    if (haystack.includes(query)) return 3;

    const parts = query.split(/\s+/);
    const allPartsIn = parts.every((p) => haystack.includes(p));
    if (allPartsIn) return 2;

    const synonyms: Record<string, string[]> = {
      'ошибка': ['error', 'проблема', 'сбой', 'неисправность'],
      'исправить': ['fix', 'решение', 'устранить', 'починить', 'восстановить'],
      'не работает': ['not working', 'не функционирует', 'сломался', 'упал'],
      'не включается': ['not turning on', 'не запускается', 'не стартует'],
      'чёрный экран': ['black screen', 'bsod', 'синий экран'],
      'тормозит': ['медленно', 'лагает', 'фризит', 'подтормаживает'],
      'не видит': ['не определяет', 'не находит', 'не распознаёт'],
      'не подключается': ['ошибка подключения', 'connection error', 'не соединяется'],
      'не сливает': ['не排水', 'забита', 'засор'],
      'не греет': ['не нагревает', 'холодный', 'не температура'],
      'не морозит': ['не охлаждает', 'теплый', 'не холодит'],
      'шумит': ['гудит', 'визжит', 'стучит', 'шум'],
      'течёт': ['протекает', 'капает', 'подтекает'],
      'не заряжается': ['не зарядка', 'разряжается', 'мёртвая батарея'],
    };

    let synonymBonus = 0;
    for (const [key, syns] of Object.entries(synonyms)) {
      const keyWords = [key, ...syns];
      const hasKey = keyWords.some((w) => query.includes(w));
      if (hasKey && keyWords.some((w) => haystack.includes(w))) {
        synonymBonus = 1;
        break;
      }
    }

    if (allPartsIn) return 2 + synonymBonus;

    const levDist = (a: string, b: string) => {
      const m = a.length, n = b.length;
      const dp: number[][] = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
      for (let i = 0; i <= m; i++) dp[i][0] = i;
      for (let j = 0; j <= n; j++) dp[0][j] = j;
      for (let i = 1; i <= m; i++)
        for (let j = 1; j <= n; j++)
          dp[i][j] = Math.min(
            dp[i - 1][j] + 1,
            dp[i][j - 1] + 1,
            dp[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
          );
      return dp[m][n];
    };

    for (const part of parts) {
      if (part.length < 3) continue;
      const words = haystack.split(/\s+/);
      for (const word of words) {
        if (word.length < 3) continue;
        const maxLen = Math.max(part.length, word.length);
        if (maxLen <= 4 && levDist(part, word) <= 1) return 1;
        if (maxLen <= 8 && levDist(part, word) <= 2) return 1;
        if (levDist(part, word) <= Math.floor(maxLen * 0.3)) return 1;
      }
    }

    return 0;
  }

  roots.forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    if (!input || !results) return;

    input.addEventListener('input', async () => {
      const query = input.value.trim().toLowerCase();
      if (query.length < 2) {
        results.classList.add('hidden');
        results.innerHTML = '';
        return;
      }

      const items = await getIndex();
      const matches = items
        .map((item) => ({ item, score: scoreItem(item, query) }))
        .filter((entry) => entry.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);

      results.innerHTML = matches.length
        ? matches.map(({ item }) => `
          <a class="block border-b border-slate-100 px-4 py-3 transition last:border-0 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800" href="/errors/${item.slug}/">
            <span class="block text-sm font-semibold text-slate-950 dark:text-white">${item.title}</span>
            <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">${item.category} · ${item.tags.slice(0, 3).join(', ')}</span>
          </a>
        `).join('')
        : '<p class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">Ничего не найдено. Попробуйте код ошибки или название программы.</p>';
      results.classList.remove('hidden');
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) results.classList.add('hidden');
    });
  });
</script>
