---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/80" data-feedback={slug}>
  <h2 class="text-base font-semibold text-slate-950 dark:text-white">Помогло ли решение?</h2>
  <div class="mt-4 flex gap-3">
    <button class="focus-ring rounded-xl bg-slate-950 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200" type="button" data-feedback-value="yes">Да</button>
    <button class="focus-ring rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-600" type="button" data-feedback-value="no">Нет</button>
  </div>
  <p class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400" data-feedback-status>Спасибо за отметку.</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-feedback]').forEach((root) => {
    const slug = root.dataset.feedback;
    const status = root.querySelector<HTMLElement>('[data-feedback-status]');
    const key = `all-manuals-feedback:${slug}`;

    if (localStorage.getItem(key) && status) status.classList.remove('hidden');

    root.querySelectorAll<HTMLButtonElement>('[data-feedback-value]').forEach((button) => {
      button.addEventListener('click', () => {
        localStorage.setItem(key, button.dataset.feedbackValue || 'unknown');
        if (status) status.classList.remove('hidden');
      });
    });
  });
</script>
