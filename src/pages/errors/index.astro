---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ErrorCard from '@/components/ErrorCard.astro';
import categories from '@/data/categories.json';

const articles = (await getCollection('errors')).filter((article) => !article.data.draft).sort(
  (a, b) => new Date(b.data.updatedAt).getTime() - new Date(a.data.updatedAt).getTime()
);

const selectedCategory = Astro.url.searchParams.get('category');
const filtered = selectedCategory
  ? articles.filter((a) => a.data.category === categories.find((c) => c.slug === selectedCategory)?.name)
  : articles;
---

<BaseLayout title="Все ошибки" description="Полный список всех ошибок с решениями на All Manuals." path="/errors/">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 dark:text-white">Все ошибки</h1>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{filtered.length} {filtered.length === 1 ? 'статья' : 'статей'}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/errors/" class="focus-ring rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-600 transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-700">Все</a>
        {categories.map((cat) => (
          <a href={`/errors/?category=${cat.slug}`} class={`focus-ring rounded-full border px-3 py-1.5 text-sm transition ${
            selectedCategory === cat.slug
              ? 'border-sky-500 bg-sky-50 text-sky-700 dark:bg-sky-950 dark:text-sky-300'
              : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-700'
          }`}>{cat.name}</a>
        ))}
      </div>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {filtered.map((article) => <ErrorCard article={article} />)}
    </div>

    {filtered.length === 0 && (
      <p class="mt-10 text-center text-slate-500 dark:text-slate-400">В этой категории пока нет статей.</p>
    )}
  </section>
</BaseLayout>
