---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ErrorCard from '@/components/ErrorCard.astro';
import categories from '@/data/categories.json';

const articles = (await getCollection('errors')).filter((article) => !article.data.draft).sort(
  (a, b) => new Date(b.data.updatedAt).getTime() - new Date(a.data.updatedAt).getTime()
);
---

<BaseLayout title="Все ошибки" description="Полный список всех ошибок с решениями на All Manuals." path="/errors/">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 dark:text-white">Все ошибки</h1>
        <p id="article-count" class="mt-2 text-sm text-slate-600 dark:text-slate-400">{articles.length} статей</p>
      </div>
      <div id="category-filters" class="flex flex-wrap gap-2">
        <a href="/errors/" data-category="" class="focus-ring cat-pill rounded-full border px-3 py-1.5 text-sm transition border-slate-200 bg-white text-slate-600 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-700">Все</a>
        {categories.map((cat) => (
          <a href={`/errors/?category=${cat.slug}`} data-category={cat.slug} class="focus-ring cat-pill rounded-full border px-3 py-1.5 text-sm transition border-slate-200 bg-white text-slate-600 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-700">{cat.name}</a>
        ))}
      </div>
    </div>

    <div id="articles-grid" class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => (
        <div data-category={categories.find((c) => c.name === article.data.category)?.slug || ''}>
          <ErrorCard article={article} />
        </div>
      ))}
    </div>

    <p id="no-articles" class="mt-10 hidden text-center text-slate-500 dark:text-slate-400">В этой категории пока нет статей.</p>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const active = params.get('category') || '';
      const cards = document.querySelectorAll('#articles-grid > div');
      const pills = document.querySelectorAll('.cat-pill');
      const count = document.getElementById('article-count');
      const noArticles = document.getElementById('no-articles');

      pills.forEach((pill) => {
        const slug = pill.getAttribute('data-category');
        if (slug === active) {
          pill.classList.add('border-sky-500', 'bg-sky-50', 'text-sky-700', 'dark:bg-sky-950', 'dark:text-sky-300');
          pill.classList.remove('border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        }
      });

      let shown = 0;
      cards.forEach((card) => {
        const slug = card.getAttribute('data-category');
        if (!active || slug === active) {
          card.style.display = '';
          shown++;
        } else {
          card.style.display = 'none';
        }
      });

      const word = shown === 1 ? 'статья' : (shown >= 2 && shown <= 4 ? 'статьи' : 'статей');
      count.textContent = shown + ' ' + word;
      noArticles.classList.toggle('hidden', shown > 0);
    })();
  </script>
</BaseLayout>
