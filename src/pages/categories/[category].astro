---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ErrorCard from '@/components/ErrorCard.astro';
import categories from '@/data/categories.json';
import { buildBreadcrumbListSchema, buildCollectionPageSchema } from '@/utils/schema';
import { categoryToSlug } from '@/utils/slug';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const articles = (await getCollection('errors'))
  .filter((article) => !article.data.draft && categoryToSlug(article.data.category) === category.slug)
  .sort((a, b) => b.data.popularityScore - a.data.popularityScore);

function buildCategoryDescription(description: string): string {
  const full = `${description} Пошаговые инструкции: симптомы, причины, безопасные проверки и действия без лишней воды.`;
  if (full.length <= 170) return full;
  return `${description} Инструкции: симптомы, причины, проверки и действия без лишней воды.`;
}

const pageTitle = `${category.name}: решения ошибок`;
const pageDescription = buildCategoryDescription(category.description);
const jsonLd = [
  buildCollectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: `/categories/${category.slug}/`,
    items: articles.slice(0, 50).map((article) => ({
      name: article.data.title,
      path: `/errors/${article.id}/`,
      description: article.data.description
    }))
  }),
  buildBreadcrumbListSchema([
    { name: 'Главная', path: '/' },
    { name: category.name, path: `/categories/${category.slug}/` }
  ])
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={`/categories/${category.slug}/`} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/86 sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-600 dark:text-sky-400">Категория</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">{category.name}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">{category.description}</p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ErrorCard article={article} />)}
    </div>

    {articles.length === 0 && <p class="mt-8 text-slate-600 dark:text-slate-400">В этой категории пока нет опубликованных инструкций.</p>}
  </section>
</BaseLayout>
